```env
# =========================================================
# SHOPIFY APP CONFIGURATION
# =========================================================

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Shopify app URL / local development URL
SHOPIFY_APP_URL=

SCOPES=read_inventory,read_orders,read_products,read_publications,read_themes,write_cart_transforms,write_discounts,write_inventory,write_products,write_publications,read_customers

SESSION_SECRET=

IS_TEST_BILLING=false


# =========================================================
# NODE CONFIGURATION
# =========================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0


# =========================================================
# DATABASE - LOCAL POSTGRESQL
# =========================================================

DATABASE_URL="postgresql://<username>:<password>@localhost:5432/<database_name>"


# =========================================================
# AWS SES CONFIGURATION
# =========================================================

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# =========================================================
# AWS EC2 CONFIGURATION
# =========================================================

EC2_USER=ubuntu
EC2_HOST=
EC2_SSH_KEY_PATH=


# =========================================================
# AWS ECR CONFIGURATION
# =========================================================

AWS_ECR_URI=


# --- AWS / SES credentials (local dev) ---
AWS_ACCESS_KEY_ID=<Provided>
AWS_SECRET_ACCESS_KEY=<Provided>
AWS_REGION=ap-south-1

# --- Email config ---
EMAIL_PROVIDER=ses
EMAIL_FROM="Bundlo <support@properoapps.in>"
EMAIL_REPLY_TO="support@properoapps.in"
EMAIL_FALLBACK_RECIPIENT="support@properoapps.in"

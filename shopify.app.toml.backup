# Learn more about configuring your app at https://shopify.dev/docs/apps/tools/cli/configuration
client_id = "60dd20a16f1ee102107ae1baded014af"
name = "Bundlo | Bundles Builder App"
api_version = "2025-10"
application_url = "https://example.com"
embedded = true

[build]
automatically_update_urls_on_dev = true

[webhooks]
api_version = "2026-04"

  [[webhooks.subscriptions]]
  uri = "/webhooks/app/uninstalled"
  topics = [ "app/uninstalled" ]

  [[webhooks.subscriptions]]
  uri = "/webhooks/orders-paid"
  topics = [ "orders/paid" ]

  [[webhooks.subscriptions]]
  uri = "/webhooks/app/scopes_update"
  topics = [ "app/scopes_update" ]

  [[webhooks.subscriptions]]
  uri = "/webhooks/refunds-create"
  topics = [ "refunds/create" ]

[access_scopes]
# Learn more at https://shopify.dev/docs/apps/tools/cli/configuration#access_scopes
scopes = "read_customers,read_inventory,read_orders,read_products,read_publications,read_themes,write_cart_transforms,write_discounts,write_inventory,write_products,write_publications"

[auth]
redirect_urls = [ "https://example.com/api/auth" ]

[app_proxy]
url = "https://example.com/api/recommendation"
subpath = "bundlo"
prefix = "apps"

[[extensions]]
type = "theme"
handle = "byob-ui"

  [[extensions.targeting]]
  target = "cart.delivery-options.discounts.generate.run"
  input_query = "src/run.graphql"
  export = "run"

[sidekick]
extensions_summary = "Search and manage bundle offers, post-purchase upsells, and cart upsell widgets to increase average order value"

[
  {
    "$schema": "https://extensions.shopifycdn.com/shopifycloud/schemas/v1/tool.json",
    "name": "search",
    "description": "Search for bundles in the merchant's Bundlo data.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query string"
        },
        "after": {
          "type": "string",
          "description": "Cursor for pagination - returns elements after this cursor"
        },
        "first": {
          "type": "integer",
          "description": "Number of results to return (default: 10)"
        }
      },
      "required": []
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier of the bundle"
              },
              "type": {
                "type": "string",
                "description": "Resource type, such as bundle"
              },
              "url": {
                "type": "string",
                "description": "URL to view the bundle"
              },
              "title": {
                "type": "string",
                "description": "Bundle title"
              }
            },
            "required": ["id", "type"]
          }
        },
        "pageInfo": {
          "type": "object",
          "properties": {
            "hasNextPage": {
              "type": "boolean"
            },
            "hasPreviousPage": {
              "type": "boolean"
            },
            "startCursor": {
              "type": "string",
              "nullable": true
            },
            "endCursor": {
              "type": "string",
              "nullable": true
            }
          }
        }
      }
    }
  },
  {
    "$schema": "https://extensions.shopifycdn.com/shopifycloud/schemas/v1/tool.json",
    "name": "get_bundle",
    "description": "Get the full details of a specific Bundlo bundle using its bundle ID.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "bundleId": {
          "type": "string",
          "description": "The unique ID of the Bundlo bundle"
        }
      },
      "required": ["bundleId"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "nullable": true
        },
        "status": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "discountType": {
          "type": "string"
        },
        "discountValue": {
          "type": "number"
        },
        "fixedPrice": {
          "type": "number",
          "nullable": true
        },
        "price": {
          "type": "number",
          "nullable": true
        },
        "available": {
          "type": "boolean"
        },
        "availableQty": {
          "type": "integer",
          "nullable": true
        },
        "productCount": {
          "type": "integer",
          "nullable": true
        },
        "shopifyProductId": {
          "type": "string",
          "nullable": true
        },
        "shopifyProductHandle": {
          "type": "string",
          "nullable": true
        },
        "endsAt": {
          "type": "string",
          "nullable": true
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": ["id", "title", "status", "type"]
    }
   },
  {
    "$schema": "https://extensions.shopifycdn.com/shopifycloud/schemas/v1/tool.json",
    "name": "get_bundle_stats",
    "description": "Get overall bundle statistics for the merchant's Bundlo app.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": []
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "totalBundles": {
          "type": "integer",
          "description": "Total number of bundles."
        },
        "activeBundles": {
          "type": "integer",
          "description": "Number of active bundles."
        },
        "totalRevenue": {
          "type": "number",
          "description": "Total revenue generated by bundles."
        },
        "rolling30DayRevenue": {
          "type": "number",
          "description": "Revenue generated by bundles during the rolling last 30 days."
        },
        "totalOrders": {
          "type": "integer",
          "description": "Total number of orders containing bundles."
        },
        "totalUnitsSold": {
          "type": "integer",
          "description": "Total number of bundle units sold."
        },
        "deltas": {
          "type": "object",
          "properties": {
            "totalBundles": {
              "type": "number",
              "nullable": true
            },
            "activeBundles": {
              "type": "number",
              "nullable": true
            }
          }
        }
      },
      "required": [
        "totalBundles",
        "activeBundles",
        "totalRevenue",
        "totalOrders",
        "totalUnitsSold"
      ]
    }
  },
  {
  "$schema": "https://extensions.shopifycdn.com/shopifycloud/schemas/v1/tool.json",
  "name": "get_bundle_analytics",
  "description": "Get bundle revenue, orders, and units sold for a specific date range, including daily breakdown.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "startDate": {
        "type": "string",
        "description": "Start date in YYYY-MM-DD format."
      },
      "endDate": {
        "type": "string",
        "description": "End date in YYYY-MM-DD format."
      }
    },
    "required": [
      "startDate",
      "endDate"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "startDate": {
        "type": "string"
      },
      "endDate": {
        "type": "string"
      },
      "summary": {
        "type": "object",
        "properties": {
          "totalRevenue": {
            "type": "number"
          },
          "totalUnitsSold": {
            "type": "integer"
          },
          "totalOrders": {
            "type": "integer"
          }
        },
        "required": [
          "totalRevenue",
          "totalUnitsSold",
          "totalOrders"
        ]
      },
      "daily": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string"
            },
            "revenue": {
              "type": "number"
            },
            "orders": {
              "type": "integer"
            },
            "quantity": {
              "type": "integer"
            }
          },
          "required": [
            "date",
            "revenue",
            "orders",
            "quantity"
          ]
        }
      }
    },
    "required": [
      "startDate",
      "endDate",
      "summary",
      "daily"
    ]
  }
},
{
  "$schema": "https://extensions.shopifycdn.com/shopifycloud/schemas/v1/tool.json",
  "name": "get_bundle_performance",
  "description": "Get Bundlo bundle-level revenue performance and performance by bundle type for a specific date range. Use this tool for questions about which bundles generated the most revenue, best-performing bundles, revenue rankings, and which bundle type performed best.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "startDate": {
        "type": "string",
        "description": "Start date in YYYY-MM-DD format."
      },
      "endDate": {
        "type": "string",
        "description": "End date in YYYY-MM-DD format."
      }
    },
    "required": [
      "startDate",
      "endDate"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "startDate": {
        "type": "string"
      },
      "endDate": {
        "type": "string"
      },
      "performance": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "bundleId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "revenue": {
              "type": "number"
            },
            "orders": {
              "type": "integer"
            },
            "quantity": {
              "type": "integer"
            }
          },
          "required": [
            "bundleId",
            "title",
            "type",
            "revenue",
            "orders",
            "quantity"
          ]
        }
      },
      "byType": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "revenue": {
              "type": "number"
            },
            "orders": {
              "type": "integer"
            },
            "quantity": {
              "type": "integer"
            }
          },
          "required": [
            "type",
            "revenue",
            "orders",
            "quantity"
          ]
        }
      }
    },
    "required": [
      "startDate",
      "endDate",
      "performance",
      "byType"
    ]
  }
}
]